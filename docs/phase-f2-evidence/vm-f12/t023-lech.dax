EVALUATE ROW("UPPER-Txt", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[UPPER-Txt], UPPER(text_cases[Txt])))), "MID-2-3", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[MID-2-3], MID(text_cases[Txt], 2, 3)))), "SUBST-a", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[SUBST-a], SUBSTITUTE(text_cases[Txt], "a", "X")))), "SUBST-a-2", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[SUBST-a-2], SUBSTITUTE(text_cases[Txt], "a", "X", 2)))), "SUBST-nfd", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[SUBST-nfd], SUBSTITUTE(text_cases[Nfd], UNICHAR(7897), "#")))), "LEN-Txt", COUNTROWS(FILTER(text_cases, text_cases[LEN-Txt] <> LEN(text_cases[Txt]))), "LOWER-Nfd", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[LOWER-Nfd], LOWER(text_cases[Nfd])))), "TRIM-Txt", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[TRIM-Txt], TRIM(text_cases[Txt])))), "REPLACE-2-3", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[REPLACE-2-3], REPLACE(text_cases[Txt], 2, 3, "__")))), "RIGHT-3", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[RIGHT-3], RIGHT(text_cases[Txt], 3)))), "REPT-2", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[REPT-2], REPT(text_cases[Txt], 2)))), "FIND-a", COUNTROWS(FILTER(text_cases, text_cases[FIND-a] <> FIND("a", text_cases[Txt], 1, -1))), "EXACT-Txt-Nfd", COUNTROWS(FILTER(text_cases, text_cases[EXACT-Txt-Nfd] <> EXACT(text_cases[Txt], text_cases[Nfd]))), "UNICODE-Txt", COUNTROWS(FILTER(text_cases, text_cases[UNICODE-Txt] <> UNICODE(text_cases[Txt]))), "FIXED-Num-1", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[FIXED-Num-1], FIXED(text_cases[Num], 1)))), "COMBINE-Txt-Num", COUNTROWS(FILTER(text_cases, NOT EXACT(text_cases[COMBINE-Txt-Num], COMBINEVALUES("|", text_cases[Txt], text_cases[Num])))))
