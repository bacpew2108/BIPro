// G1-year__CR.dax | 29 measure, mỗi measure kèm 1 cột ISBLANK | Chạy, Copy kết quả, dán vào G1-year__CR.tsv
EVALUATE
SUMMARIZECOLUMNS (
	'Dim_Date'[year],
	"Avg_Days_To_Company", 'Fact_CRM_Complaint'[Avg_Days_To_Company],
	"Avg_Days_To_Company · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Avg_Days_To_Company] ),
	"Avg_Days_To_Company Δ", 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ],
	"Avg_Days_To_Company Δ · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ] ),
	"Avg_Days_To_Company Δ Color", 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ Color],
	"Avg_Days_To_Company Δ Color · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ Color] ),
	"Avg_Days_To_Company Δ Label", 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ Label],
	"Avg_Days_To_Company Δ Label · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Avg_Days_To_Company Δ Label] ),
	"Channel Share %", 'Fact_CRM_Complaint'[Channel Share %],
	"Channel Share % · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Channel Share %] ),
	"Complaints", 'Fact_CRM_Complaint'[Complaints],
	"Complaints · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints] ),
	"Complaints MA3", 'Fact_CRM_Complaint'[Complaints MA3],
	"Complaints MA3 · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints MA3] ),
	"Complaints per 1000 Clients", 'Fact_CRM_Complaint'[Complaints per 1000 Clients],
	"Complaints per 1000 Clients · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints per 1000 Clients] ),
	"Complaints Δ", 'Fact_CRM_Complaint'[Complaints Δ],
	"Complaints Δ · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints Δ] ),
	"Complaints Δ Color", 'Fact_CRM_Complaint'[Complaints Δ Color],
	"Complaints Δ Color · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints Δ Color] ),
	"Complaints Δ Label", 'Fact_CRM_Complaint'[Complaints Δ Label],
	"Complaints Δ Label · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Complaints Δ Label] ),
	"Dispute_Rate", 'Fact_CRM_Complaint'[Dispute_Rate],
	"Dispute_Rate · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Dispute_Rate] ),
	"Dispute_Rate Δ", 'Fact_CRM_Complaint'[Dispute_Rate Δ],
