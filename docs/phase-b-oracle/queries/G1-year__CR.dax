	"Dispute_Rate Δ Color", 'Fact_CRM_Complaint'[Dispute_Rate Δ Color],
	"Dispute_Rate Δ Color · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Dispute_Rate Δ Color] ),
	"Dispute_Rate Δ Label", 'Fact_CRM_Complaint'[Dispute_Rate Δ Label],
	"Dispute_Rate Δ Label · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Dispute_Rate Δ Label] ),
	"Pareto 80% Line", 'Fact_CRM_Complaint'[Pareto 80% Line],
	"Pareto 80% Line · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Pareto 80% Line] ),
	"Pareto Color", 'Fact_CRM_Complaint'[Pareto Color],
	"Pareto Color · ISBLANK", ISBLANK ( 'Fact_CRM_Complaint'[Pareto Color] ),
	"Pareto Cum %", 'Fact_CRM_Complaint'[Pareto Cum %],
