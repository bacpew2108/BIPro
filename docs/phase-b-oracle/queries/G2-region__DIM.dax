// G2-region__DIM.dax | 18 measure, mỗi measure kèm 1 cột ISBLANK | Chạy, Copy kết quả, dán vào G2-region__DIM.tsv
EVALUATE
SUMMARIZECOLUMNS (
	'Dim_Client'[client_region],
	"Total_Clients", 'Dim_Client'[Total_Clients],
	"Total_Clients · ISBLANK", ISBLANK ( 'Dim_Client'[Total_Clients] ),
	"Total_Clients Sub Color", 'Dim_Client'[Total_Clients Sub Color],
	"Total_Clients Sub Color · ISBLANK", ISBLANK ( 'Dim_Client'[Total_Clients Sub Color] ),
	"Total_Clients Sub Label", 'Dim_Client'[Total_Clients Sub Label],
	"Total_Clients Sub Label · ISBLANK", ISBLANK ( 'Dim_Client'[Total_Clients Sub Label] ),
	"Branch Loan Amount", 'Dim_District'[Branch Loan Amount],
	"Branch Loan Amount · ISBLANK", ISBLANK ( 'Dim_District'[Branch Loan Amount] ),
	"Branch Loan Count", 'Dim_District'[Branch Loan Count],
	"Branch Loan Count · ISBLANK", ISBLANK ( 'Dim_District'[Branch Loan Count] ),
	"Branch NPL Label", 'Dim_District'[Branch NPL Label],
	"Branch NPL Label · ISBLANK", ISBLANK ( 'Dim_District'[Branch NPL Label] ),
	"Branch Outstanding", 'Dim_District'[Branch Outstanding],
	"Branch Outstanding · ISBLANK", ISBLANK ( 'Dim_District'[Branch Outstanding] ),
	"Branch Subtitle", 'Dim_District'[Branch Subtitle],
	"Branch Subtitle · ISBLANK", ISBLANK ( 'Dim_District'[Branch Subtitle] ),
	"Branch Title", 'Dim_District'[Branch Title],
	"Branch Title · ISBLANK", ISBLANK ( 'Dim_District'[Branch Title] ),
	"D4 Active Accounts", 'Dim_District'[D4 Active Accounts],
	"D4 Active Accounts · ISBLANK", ISBLANK ( 'Dim_District'[D4 Active Accounts] ),
	"D4 Avg_Days_To_Company", 'Dim_District'[D4 Avg_Days_To_Company],
	"D4 Avg_Days_To_Company · ISBLANK", ISBLANK ( 'Dim_District'[D4 Avg_Days_To_Company] ),
	"D4 Complaints", 'Dim_District'[D4 Complaints],
	"D4 Complaints · ISBLANK", ISBLANK ( 'Dim_District'[D4 Complaints] ),
	"D4 Dispute_Rate", 'Dim_District'[D4 Dispute_Rate],
	"D4 Dispute_Rate · ISBLANK", ISBLANK ( 'Dim_District'[D4 Dispute_Rate] ),
	"D4 Overdraft Rate", 'Dim_District'[D4 Overdraft Rate],
	"D4 Overdraft Rate · ISBLANK", ISBLANK ( 'Dim_District'[D4 Overdraft Rate] ),
	"D4 SLA_Timely_Rate", 'Dim_District'[D4 SLA_Timely_Rate],
	"D4 SLA_Timely_Rate · ISBLANK", ISBLANK ( 'Dim_District'[D4 SLA_Timely_Rate] ),
	"D4 Timely Color", 'Dim_District'[D4 Timely Color],
	"D4 Timely Color · ISBLANK", ISBLANK ( 'Dim_District'[D4 Timely Color] ),
	"D4 Trans Amount", 'Dim_District'[D4 Trans Amount],
	"D4 Trans Amount · ISBLANK", ISBLANK ( 'Dim_District'[D4 Trans Amount] ),
	"D4 Trans Count", 'Dim_District'[D4 Trans Count],
	"D4 Trans Count · ISBLANK", ISBLANK ( 'Dim_District'[D4 Trans Count] )
)
ORDER BY 'Dim_Client'[client_region]
