// T1-blank-arith | BLANK, chia 0, ép kiểu và hàm toán. Chạy, Copy kết quả, dán vào T1-blank-arith.tsv
EVALUATE
ROW (
	"blank+5", BLANK () + 5,
	"blank+5 · ISBLANK", ISBLANK ( BLANK () + 5 ),
	"blank-5", BLANK () - 5,
	"blank-5 · ISBLANK", ISBLANK ( BLANK () - 5 ),
	"blank*5", BLANK () * 5,
	"blank*5 · ISBLANK", ISBLANK ( BLANK () * 5 ),
	"blank/5", BLANK () / 5,
	"blank/5 · ISBLANK", ISBLANK ( BLANK () / 5 ),
	"5/blank", 5 / BLANK (),
	"5/blank · ISBLANK", ISBLANK ( 5 / BLANK () ),
	"0/blank", 0 / BLANK (),
	"0/blank · ISBLANK", ISBLANK ( 0 / BLANK () ),
	"blank/blank", BLANK () / BLANK (),
	"blank/blank · ISBLANK", ISBLANK ( BLANK () / BLANK () ),
	"blank&x", BLANK () & "x",
	"blank&x · ISBLANK", ISBLANK ( BLANK () & "x" ),
	"blank=0", BLANK () = 0,
	"blank=0 · ISBLANK", ISBLANK ( BLANK () = 0 ),
	"blank=empty", BLANK () = "",
	"blank=empty · ISBLANK", ISBLANK ( BLANK () = "" ),
	"isblank(0)", ISBLANK ( 0 ),
	"isblank(0) · ISBLANK", ISBLANK ( ISBLANK ( 0 ) ),
	"blank&&true", BLANK () && TRUE (),
	"blank&&true · ISBLANK", ISBLANK ( BLANK () && TRUE () ),
	"blank||true", BLANK () || TRUE (),
	"blank||true · ISBLANK", ISBLANK ( BLANK () || TRUE () ),
	"divide(1,0)", DIVIDE ( 1, 0 ),
	"divide(1,0) · ISBLANK", ISBLANK ( DIVIDE ( 1, 0 ) ),
	"divide(1,0,-1)", DIVIDE ( 1, 0, -1 ),
	"divide(1,0,-1) · ISBLANK", ISBLANK ( DIVIDE ( 1, 0, -1 ) ),
	"int(-2.5)", INT ( -2.5 ),
	"int(-2.5) · ISBLANK", ISBLANK ( INT ( -2.5 ) ),
	"mod(-7,3)", MOD ( -7, 3 ),
	"mod(-7,3) · ISBLANK", ISBLANK ( MOD ( -7, 3 ) ),
	"mod(7,-3)", MOD ( 7, -3 ),
	"mod(7,-3) · ISBLANK", ISBLANK ( MOD ( 7, -3 ) ),
	"round(2.675,2)", ROUND ( 2.675, 2 ),
	"round(2.675,2) · ISBLANK", ISBLANK ( ROUND ( 2.675, 2 ) ),
	"date(2018,13,1)", DATE ( 2018, 13, 1 ),
	"date(2018,13,1) · ISBLANK", ISBLANK ( DATE ( 2018, 13, 1 ) ),
	"""1""+1", "1" + 1,
	"""1""+1 · ISBLANK", ISBLANK ( "1" + 1 )
)
