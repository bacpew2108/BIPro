// O1 | Định dạng kết quả trong lưới (oracle-ui.md mục 2.4). Chạy, chụp lưới, rồi Copy kết quả
EVALUATE
ROW (
	"int", 1,
	"dbl", 1 / 3,
	"big", 6257793560.3,
	"neg", -0.000001,
	"cur", CURRENCY ( 1.23456 ),
	"date", DATE ( 2018, 12, 31 ),
	"dt", NOW () * 0 + DATE ( 2018, 12, 31 ) + TIME ( 16, 3, 36 ),
	"bool", TRUE (),
	"blank", BLANK (),
	"empty", "",
	"vn", "Không có số liệu ▲",
	"inf", 5 / BLANK (),
	"nan", 0 / BLANK ()
)
