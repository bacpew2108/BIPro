// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			AND('Dim_Date'[year] IN {2016}, NOT('Dim_Date'[year] IN {9999}))
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Dim_Date'[year],
			'Dim_Date'[quarter_name],
			'Dim_Date'[quarter_num],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Loan_Amount2", 'Fact_Loan'[Loan Amount],
			"Loan_Count2", 'Fact_Loan'[Loan Count]
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, 'Dim_Date'[year], 1, 'Dim_Date'[quarter_num], 1, 'Dim_Date'[quarter_name], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Dim_Date'[year], 'Dim_Date'[quarter_num], 'Dim_Date'[quarter_name]
