// DAX Query
DEFINE
	VAR __H0FilterTable = 
		TREATAS({"35-49"}, 'Fact_Loan'[age_group_at_loan])

	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Dim_Client'[age_group_current],
			'Dim_Client'[age_group_order],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Loan_Count2", 'Fact_Loan'[Loan Count],
			"Fact_LoanLoan_Count2", IGNORE(CALCULATE('Fact_Loan'[Loan Count], KEEPFILTERS(__H0FilterTable))),
			"Bad_Debt_Ratio_Count", 'Fact_Loan'[Bad_Debt_Ratio_Count],
			"v_Bad_Debt_Ratio_Count_FormatString", IGNORE('Fact_Loan'[_Bad_Debt_Ratio_Count FormatString]),
			"Fact_LoanBad_Debt_Ratio_Count", IGNORE(CALCULATE('Fact_Loan'[Bad_Debt_Ratio_Count], KEEPFILTERS(__H0FilterTable))),
			"Fact_Loanv_Bad_Debt_Ratio_Count_FormatString", IGNORE(
				CALCULATE('Fact_Loan'[_Bad_Debt_Ratio_Count FormatString], KEEPFILTERS(__H0FilterTable))
			),
			"NPL_Group_Color", IGNORE('Fact_Loan'[NPL Group Color]),
			"Fact_LoanNPL_Group_Color", IGNORE(CALCULATE('Fact_Loan'[NPL Group Color], KEEPFILTERS(__H0FilterTable)))
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(1001, __DS0Core, 'Dim_Client'[age_group_order], 1, 'Dim_Client'[age_group_current], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Dim_Client'[age_group_order], 'Dim_Client'[age_group_current]
