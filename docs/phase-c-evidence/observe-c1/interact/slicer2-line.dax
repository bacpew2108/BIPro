// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			AND('Dim_Date'[year] IN {2016,
				2017}, NOT('Dim_Date'[year] IN {9999}))
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Dim_Date'[month_start],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Trans_Amount", 'Fact_Transaction'[Trans Amount],
			"Trans_Count2", IGNORE('Fact_Transaction'[Trans Count])
		)

	VAR __DS0IntersectionCount = CALCULATE(COUNTROWS(__DS0Core))

	VAR __DS0BodyBinnedSample = 
		SAMPLEAXISWITHLOCALMINMAX(3500, __DS0Core, 'Dim_Date'[month_start], [Trans_Amount], 350, , ALPHABETICAL, ASC, 105000, 60)

EVALUATE
	ROW(
	"DS0IntersectionCount", __DS0IntersectionCount
)

EVALUATE
	__DS0BodyBinnedSample

ORDER BY
	'Dim_Date'[month_start]
