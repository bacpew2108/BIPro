// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DM3FilterTable = 
		TREATAS({2011}, 'Dim_Date'[year])

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				'Dim_Date'[year], "IsGrandTotalRowTotal",
				ROLLUPGROUP('Dim_Date'[quarter_name], 'Dim_Date'[quarter_num]),
				"IsDM1Total",
				NONVISUAL(__DM3FilterTable)
			),
			__DS0FilterTable,
			__DS0FilterTable2
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			502,
			__DS0Core,
			[IsGrandTotalRowTotal],
			0,
			'Dim_Date'[year],
			1,
			[IsDM1Total],
			0,
			'Dim_Date'[quarter_num],
			1,
			'Dim_Date'[quarter_name],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'Dim_Date'[year],
	[IsDM1Total] DESC,
	'Dim_Date'[quarter_num],
	'Dim_Date'[quarter_name]
