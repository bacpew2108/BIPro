// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		CALCULATETABLE(
			VALUES('Dim_Trans_Type'[trans_type]),
			KEEPFILTERS(__DS0FilterTable),
			KEEPFILTERS(__DS0FilterTable2)
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(501, __DS0Core, 'Dim_Trans_Type'[trans_type], 1)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Dim_Trans_Type'[trans_type]
