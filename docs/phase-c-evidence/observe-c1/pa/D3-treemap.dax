// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Dim_CRM_Issue'[product],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Complaints", 'Fact_CRM_Complaint'[Complaints],
			"SLA_Timely_Rate", IGNORE('Fact_CRM_Complaint'[SLA_Timely_Rate]),
			"v_SLA_Timely_Rate_FormatString", IGNORE('Fact_CRM_Complaint'[_SLA_Timely_Rate FormatString]),
			"Dispute_Rate", IGNORE('Fact_CRM_Complaint'[Dispute_Rate]),
			"v_Dispute_Rate_FormatString", IGNORE('Fact_CRM_Complaint'[_Dispute_Rate FormatString])
		)

	VAR __DS0BodyLimited = 
		TOPN(1002, __DS0Core, [Complaints], 0, 'Dim_CRM_Issue'[product], 1)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[Complaints] DESC, 'Dim_CRM_Issue'[product]
