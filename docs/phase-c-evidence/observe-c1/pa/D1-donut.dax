// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL('Dim_Trans_Type'[trans_type], "IsGrandTotalRowTotal"),
			__DS0FilterTable,
			__DS0FilterTable2,
			"Trans_Amount", 'Fact_Transaction'[Trans Amount],
			"v__Trans_Amount", IGNORE('Fact_Transaction'[% Trans Amount]),
			"v___Trans_Amount_FormatString", IGNORE('Fact_Transaction'[_% Trans Amount FormatString]),
			"Trans_Count2", IGNORE('Fact_Transaction'[Trans Count])
		)

	VAR __DS0BodyLimited = 
		TOPN(1002, __DS0Core, [IsGrandTotalRowTotal], 0, 'Dim_Trans_Type'[trans_type], 1)

EVALUATE
	__DS0BodyLimited

ORDER BY
	[IsGrandTotalRowTotal] DESC, 'Dim_Trans_Type'[trans_type]
