// DAX Query
DEFINE
	VAR __DS0FilterTable = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Date'[year])),
			NOT('Dim_Date'[year] IN {9999})
		)

	VAR __DS0FilterTable2 = 
		FILTER(
			KEEPFILTERS(VALUES('Dim_Client'[client_region])),
			NOT('Dim_Client'[client_region] IN {"Unknown"})
		)

	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			'Fact_Loan'[age_group_at_loan],
			'Fact_Loan'[age_group_at_loan_order],
			__DS0FilterTable,
			__DS0FilterTable2,
			"Bad_Debt_Ratio_Count", 'Fact_Loan'[Bad_Debt_Ratio_Count],
			"v_Bad_Debt_Ratio_Count_FormatString", IGNORE('Fact_Loan'[_Bad_Debt_Ratio_Count FormatString]),
			"Bad_Debt_Ratio_Value", IGNORE('Fact_Loan'[Bad_Debt_Ratio_Value]),
			"v_Bad_Debt_Ratio_Value_FormatString", IGNORE('Fact_Loan'[_Bad_Debt_Ratio_Value FormatString]),
			"Bad_Debt_Loans", IGNORE('Fact_Loan'[Bad Debt Loans]),
			"Loan_Count2", IGNORE('Fact_Loan'[Loan Count]),
			"NPL_Group_Color", IGNORE('Fact_Loan'[NPL Group Color])
		)

	VAR __DS0PrimaryWindowed = 
		TOPN(
			1001,
			__DS0Core,
			'Fact_Loan'[age_group_at_loan_order],
			1,
			'Fact_Loan'[age_group_at_loan],
			1
		)

EVALUATE
	__DS0PrimaryWindowed

ORDER BY
	'Fact_Loan'[age_group_at_loan_order], 'Fact_Loan'[age_group_at_loan]
